node_modules/
*.log
.DS_Store
coverage/

# The store, from step 28.3 on. It is data the application wrote, not source, and
# a committed one would give every clone somebody else's links.
links.json
links.json.*.tmp

# Profiler output. bench/profile.mjs writes a .cpuprofile here on every run; it is
# a few hundred kilobytes of machine-specific samples and it is regenerated by
# running the tool again.
bench/.profile/
*.cpuprofile
